@startuml
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam ArrowFontSize 16
skinparam shadowing false
hide empty description
skinparam stateBackgroundColor white
skinparam stateBorderColor black
skinparam stateBorderThickness 1
skinparam roundcorner 0
skinparam linetype polyline
title R2 proposals in FirstUse
state "Proposal check (state unchanged)" as Scope {
state "FirstUse" as S
[*] --> S
S -left-> S : [(source == "human")]\n/ human_bypass
S -right-> S : [((source == "ai") && ((event.device ==\n"air_conditioner") && (event.mode == "cool") &&\n!(ac) && (elapsed != null) && (elapsed < rest_s)))]\n/ block: ac_cooldown
S -down-> S : [((source == "ai") && !(((event.device ==\n"air_conditioner") && (event.mode == "cool") &&\n!(ac) && (elapsed != null) && (elapsed < rest_s))))]\n/ allow
}
@enduml
